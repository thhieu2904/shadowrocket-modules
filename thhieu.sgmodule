#!name=THHIEU Module
#!desc=RevenueCat Subscriber Modifier for Locket - Inject Gold entitlement
#!author=thhieu2904
#!homepage=https://github.com/thhieu2904/shadowrocket-modules

[Script]
; Script 1: Xóa cache header trước khi request rời máy (chống 304)
THHIEU_Req = type=http-request, pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/?]+$|receipts$), script-path=https://raw.githubusercontent.com/thhieu2904/shadowrocket-modules/main/thhieu-req.js, timeout=30

; Script 2: Sửa body response để inject Gold entitlement
THHIEU_Res = type=http-response, pattern=^https?:\/\/api\.revenuecat\.com\/v1\/(subscribers\/[^\/?]+$|receipts$), requires-body=true, max-size=-1, timeout=30, script-path=https://raw.githubusercontent.com/thhieu2904/shadowrocket-modules/main/thhieu.js

[MITM]
hostname = api.revenuecat.com